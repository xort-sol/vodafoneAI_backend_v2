# Copy to .env and fill in. Never put real keys in this file.
# LiveKit Cloud project > Settings > API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BUSINESS_NAME=Vodafone

# Optional. openai/gpt-4.1 follows the sales rules a bit more reliably but replies slower and costs more.
# LLM_MODEL=openai/gpt-4.1-mini

# ElevenLabs: elevenlabs.io > Settings > API keys. Voice ID from the Voice Library ("Copy voice ID").
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=UgBBYS2sOqTuMpoF3BR0

# Leave empty to test in the Agent Console without a phone line.
# Set to your LiveKit outbound trunk ID (lk sip outbound list) to place real calls.
SIP_OUTBOUND_TRUNK_ID=

# Supabase: Project > Connect > "Session pooler" connection string (the direct one is IPv6-only).
# Every call outcome and transcript is saved here.
DATABASE_URL=

# Google Sheet copy of each outcome (see google_sheet/apps_script.js). Optional: leave the URL empty to skip it.
RESULTS_WEBHOOK_URL=
RESULTS_WEBHOOK_TOKEN=
